# Secrets. The LLM gateway key lives here and must never be committed.
.env

# Python environment
.venv/
__pycache__/
*.pyc

# Captures and reconstructions: gigabytes of the user's own photos.
projects/
workspace/
images/

# Build outputs. The APK and the firmware images belong in a GitHub release,
# not in the tree.
dist/
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
turntable/firmware/*.o
turntable/firmware/*.elf
turntable/firmware/*.bin
turntable/firmware/*.map
turntable/firmware/slot-*.ld

# Machine-specific: the Android SDK location and the JDK the daemon runs on.
android/local.properties
