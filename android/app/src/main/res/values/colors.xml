<?xml version="1.0" encoding="utf-8"?>
<!--
  One palette, two front ends. These are the exact values the web UI uses for
  its Material 3 dark scheme, so moving between the phone and the browser does
  not read as two different products. Do not re-derive them from a seed colour:
  a tonal palette generated from #FFB449 does not land on these numbers, and the
  two halves would drift apart at the next regeneration.

  Amber #FFB449 is the identity; the #0B0F14 family is the ground it sits on.
-->
<resources>
    <color name="collmap_primary">#FFB449</color>
    <color name="collmap_on_primary">#452B00</color>
    <color name="collmap_primary_container">#633F00</color>
    <color name="collmap_on_primary_container">#FFDDB3</color>

    <color name="collmap_secondary">#5B7FFF</color>
    <color name="collmap_on_secondary">#001A43</color>
    <!-- Not in the shared list: derived to complete the secondary role so the
         widgets that need a container have one in the right hue. -->
    <color name="collmap_secondary_container">#2B4899</color>
    <color name="collmap_on_secondary_container">#DCE1FF</color>

    <!-- Likewise derived. The old palette's green marked "locked" and "done";
         it lives on as the tertiary role rather than as a stray constant. -->
    <color name="collmap_tertiary">#4ED6A1</color>
    <color name="collmap_on_tertiary">#003828</color>
    <color name="collmap_tertiary_container">#00513B</color>
    <color name="collmap_on_tertiary_container">#6FF3BD</color>

    <color name="collmap_error">#FF5C4D</color>
    <color name="collmap_on_error">#40000A</color>
    <color name="collmap_error_container">#93000F</color>
    <color name="collmap_on_error_container">#FFDAD5</color>

    <color name="collmap_surface">#0B0F14</color>
    <color name="collmap_on_surface">#E6EDF5</color>
    <color name="collmap_surface_variant">#1B232D</color>
    <color name="collmap_on_surface_variant">#8496A8</color>

    <!-- Tonal elevation, the same way the web does it: a raised surface is a
         lighter container, not a heavier shadow. -->
    <color name="collmap_surface_container_lowest">#070A0E</color>
    <color name="collmap_surface_container_low">#141A22</color>
    <color name="collmap_surface_container">#1B232D</color>
    <color name="collmap_surface_container_high">#222C38</color>
    <color name="collmap_surface_container_highest">#2A3441</color>

    <color name="collmap_outline">#2A3441</color>
    <color name="collmap_outline_variant">#1B232D</color>
    <color name="collmap_scrim">#000000</color>

    <!-- The control strips float over the viewfinder; they need to be legible
         without hiding the picture behind them. -->
    <color name="strip_scrim">#CC0B0F14</color>
    <color name="viewer_scrim">#0B0F14</color>

    <color name="ic_launcher_background">#0B0F14</color>
</resources>
