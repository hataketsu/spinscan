<?xml version="1.0" encoding="utf-8"?>
<!--
  The type scale, pointed at the same two families the web UI uses: Be Vietnam
  Pro for everything a person reads as prose, IBM Plex Mono for the things that
  are really data: filenames, counters, board replies, the pipeline log.

  Material 3's own text appearances hardcode a font family, so setting
  android:fontFamily on the theme alone is not enough: each role has to be
  re-pointed. That is what this file is, and it is why no view in the app sets
  a typeface of its own.
-->
<resources>
    <style name="TextAppearance.Collmap.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
    </style>
    <style name="TextAppearance.Collmap.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
    </style>
    <style name="TextAppearance.Collmap.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
    </style>
    <style name="TextAppearance.Collmap.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
    </style>
    <style name="TextAppearance.Collmap.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
        <item name="fontFamily">@font/be_vietnam_pro</item>
    </style>
    <style name="TextAppearance.Collmap.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/be_vietnam_pro</item>
